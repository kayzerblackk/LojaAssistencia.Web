@model List<LojaAssistencia.Web.Models.Produto>

    <div class="text-center">

        <h1 class="display-2">Produtos cadastrados</h1>
        <h1>Total de produtos: @Model.Count</h1>

    </div>

    <br>

    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Produto</th>
                <th>Descrição</th>
                <th>Preço</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var produto in Model)
            {
                <tr>
                    <td>@produto.Nome</td>
                    <td>@produto.Descricao</td>
                    <td>@produto.Preco</td>
                </tr>
            }
        </tbody>
    </table>